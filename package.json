{
  "name": "langur-burja",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n server,web -c yellow,cyan \"npm:server\" \"npm:web\"",
    "web": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "build": "vite build",
    "serve": "node server/index.js",
    "test:server": "node tests/run-server-tests.mjs",
    "test": "npm run test:unit && npm run test:server && npm run test:persist",
    "test:unit": "node --test tests/*.test.mjs",
    "test:persist": "node server/persist-test.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
